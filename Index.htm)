<!DOCTYPE html>
<html lang="es">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1.0">
  <title>GananciaPY2
</title>

  <style>
    body {
      font-family: Arial, sans-serif;
      background: #f2f2f2;
      margin: 0;
      padding: 20px;
    }

    .contenedor {
      max-width: 500px;
      margin: auto;
    }

    h1 {
      text-align: center;
      margin-bottom: 5px;
    }

    .subtitulo {
      text-align: center;
      color: #666;
      margin-bottom: 25px;
    }

    .tarjeta {
      background: white;
      padding: 20px;
      border-radius: 15px;
      margin-bottom: 20px;
      box-shadow: 0 3px 10px rgba(0,0,0,0.08);
    }

    h2 {
      margin-top: 0;
    }

    label {
      display: block;
      margin-top: 12px;
      margin-bottom: 5px;
      font-weight: bold;
    }

    input {
      width: 100%;
      box-sizing: border-box;
      padding: 12px;
      border: 1px solid #ccc;
      border-radius: 8px;
      font-size: 16px;
    }

    button {
      width: 100%;
      margin-top: 18px;
      padding: 13px;
      border: none;
      border-radius: 8px;
      font-size: 16px;
      font-weight: bold;
      cursor: pointer;
      background: #222;
      color: white;
    }

    .resultado {
      margin-top: 18px;
      padding: 15px;
      background: #f5f5f5;
      border-radius: 10px;
      line-height: 1.7;
    }
  </style>
</head>

<body>

  <div class="contenedor">

    <h1>GananciaPY</h1>
    <p class="subtitulo">Herramientas simples para calcular tu dinero y tu negocio.</p>

    <!-- CALCULADORA DE GANANCIA -->
    <div class="tarjeta">
      <h2>🧮 Calcular ganancia</h2>

      <label>Precio de compra</label>
      <input type="number" id="compra" placeholder="Ej: 50000">

      <label>Precio de venta</label>
      <input type="number" id="venta" placeholder="Ej: 70000">

      <label>Cantidad vendida</label>
      <input type="number" id="cantidad" placeholder="Ej: 10">

      <button onclick="calcularGanancia()">Calcular</button>

      <div class="resultado" id="resultadoGanancia">
        Aquí aparecerá tu resultado.
      </div>
    </div>


    <!-- CALCULADORA DE PRECIO -->
    <div class="tarjeta">
      <h2>💰 ¿A cuánto vender?</h2>

      <label>Costo del producto</label>
      <input type="number" id="costo" placeholder="Ej: 50000">

      <label>Ganancia deseada (%)</label>
      <input type="number" id="porcentaje" placeholder="Ej: 30">

      <button onclick="calcularPrecio()">Calcular precio</button>

      <div class="resultado" id="resultadoPrecio">
        Aquí aparecerá el precio recomendado.
      </div>
    </div>

  </div>


  <script>

    function calcularGanancia() {

      const compra = Number(document.getElementById("compra").value);
      const venta = Number(document.getElementById("venta").value);
      const cantidad = Number(document.getElementById("cantidad").value);

      if (compra <= 0 || venta <= 0 || cantidad <= 0) {
        document.getElementById("resultadoGanancia").innerHTML =
          "⚠️ Completa todos los campos correctamente.";
        return;
      }

      const gananciaUnidad = venta - compra;
      const gananciaTotal = gananciaUnidad * cantidad;
      const margen = (gananciaUnidad / venta) * 100;

      document.getElementById("resultadoGanancia").innerHTML = `
        💵 Ganancia por unidad: G. ${gananciaUnidad.toLocaleString("es-PY")}<br>
        💰 Ganancia total: G. ${gananciaTotal.toLocaleString("es-PY")}<br>
        📊 Margen de ganancia: ${margen.toFixed(2)}%
      `;
    }


    function calcularPrecio() {

      const costo = Number(document.getElementById("costo").value);
      const porcentaje = Number(document.getElementById("porcentaje").value);

      if (costo <= 0 || porcentaje < 0) {
        document.getElementById("resultadoPrecio").innerHTML =
          "⚠️ Completa los campos correctamente.";
        return;
      }

      const precio = costo * (1 + porcentaje / 100);

      document.getElementById("resultadoPrecio").innerHTML = `
        💰 Precio recomendado: <strong>G. ${precio.toLocaleString("es-PY")}</strong>
      `;
    }

  </script>

</body>
</html>


